<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit.v3"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  
  <ItemGroup>
    <!--
    VersionOverride, not Version: central package management (Directory.Packages.props) applies to this
    project too, and the version here is the temp one produced by `dotnet pack` for integration testing.
    -->
    <PackageReference Include="NoahStolk.EnumGenerator" VersionOverride="0.0.0-temp">
      <!-- Make sure to include "compile" assets as we need the DLL inside the "lib" folder. -->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\EnumGenerator.Tests.Integration\**\*.cs" Link="%(Filename)%(Extension)"/>
  </ItemGroup>

</Project>
